# ===== Banco de dados =====
# SQLite (padrão). Em produção use caminho absoluto fora da pasta do app, ex.: file:/dados/loja/loja.db
DATABASE_URL="file:./dev.db"

# ===== Autenticação =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# true quando servido via HTTPS (recomendado em produção)
COOKIE_SECURE=false
# Permitir que colaboradores criem a própria conta (o papel inicial é sempre USER)
ALLOW_REGISTRATION=true
# Restringe o cadastro a um domínio de e-mail (ex.: empresa.com.br). Vazio = qualquer domínio.
ALLOWED_EMAIL_DOMAIN=

# ===== Admin Master (usado apenas pelo `npm run db:seed`) =====
MASTER_EMAIL=
MASTER_PASSWORD=
MASTER_NAME="Admin Master"

# ===== Rede =====
# true atrás de proxy reverso (IIS/Nginx) que SOBRESCREVE X-Forwarded-For. Necessário para auditoria de IP e instalação remota.
TRUST_PROXY=true

# ===== Armazenamento de arquivos =====
# Pasta de instaladores e imagens (faça backup!). Padrão: ./storage
STORAGE_DIR=
MAX_UPLOAD_MB=2048
# Extensões aceitas para instaladores
ALLOWED_PACKAGE_EXT=.exe,.msi,.msix,.msixbundle,.appx,.zip,.7z,.rar,.apk,.dmg,.pkg,.deb,.rpm,.appimage,.jar,.pdf

# ===== Instalação remota via ITOM/ITAM (opcional) =====
ITOM_ENABLED=false
ITOM_MYSQL_HOST=
ITOM_MYSQL_PORT=3306
ITOM_MYSQL_DATABASE=
ITOM_MYSQL_USER=
ITOM_MYSQL_PASSWORD=
ITOM_AUTOMATION_URL=http://servidor-itam/ITAM/Automation
ITOM_SITE_ID=1
