// Banco da Loja de Software.
// Padrão: SQLite (arquivo único, ideal para servidor de intranet).
// Para MySQL: troque provider para "mysql", ajuste DATABASE_URL e
// adicione @db.Text nos campos longos (description, changelog, body, details).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Papéis: USER (baixa apps), ADMIN (gerencia catálogo e notícias), MASTER (tudo + gerencia admins)
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("USER")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  versionsUploaded AppVersion[] @relation("UploadedBy")
  news        News[]
  downloads   Download[]
  auditLogs   AuditLog[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  apps      App[]
}

model App {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  publisher        String       @default("Equipe de Desenvolvimento de Soluções")
  shortDescription String
  description      String
  iconPath         String?
  bannerPath       String?
  website          String?
  tags             String       @default("")
  featured         Boolean      @default(false)
  published        Boolean      @default(false)
  /// ID do pacote no ITAM/ITOM para instalação remota (opcional)
  itomPackageId    Int?
  downloadCount    Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions    AppVersion[]
  screenshots Screenshot[]
  news        News[]
  downloads   Download[]

  @@index([published, featured])
}

model AppVersion {
  id           String   @id @default(cuid())
  version      String
  changelog    String   @default("")
  fileName     String
  filePath     String
  fileSize     BigInt
  sha256       String
  mimeType     String   @default("application/octet-stream")
  /// Ex.: windows-x64, windows-x86, linux, macos, web
  platform     String   @default("windows-x64")
  downloads    Int      @default(0)
  createdAt    DateTime @default(now())

  appId        String
  app          App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  downloadLogs Download[]

  @@unique([appId, version, platform])
  @@index([appId, createdAt])
}

model Screenshot {
  id        String   @id @default(cuid())
  path      String
  caption   String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
}

model News {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String
  body        String
  coverPath   String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appId    String?
  app      App?    @relation(fields: [appId], references: [id], onDelete: SetNull)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
}

model Download {
  id        String     @id @default(cuid())
  ip        String?
  createdAt DateTime   @default(now())
  appId     String
  app       App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  versionId String
  version   AppVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([appId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String   @default("")
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
